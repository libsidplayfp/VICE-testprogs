
; related to https://sourceforge.net/p/vice-emu/bugs/2025/

; The assign registers command (r) somehow repeats the current
; instruction when the command is used

logname "bug2025-4b.log"
log on

break 1000
break e147

a 1000
inx
stx $1005
rts
brk

keybuf sys4096\n
x

; here, INX is executed twice, but x remains unchanged the first time

r a = ff
x

m 1005 1005
chis 5
q
