; related to https://sourceforge.net/p/vice-emu/bugs/2220/
; Checkpoints for non-default devices are unreliable

logname "bug2220-1.log"
log on

watch 0800 9fff
watch c000 cfff

dev 8:
watch 0600 0700

a 0300 sei
sta $0600
jmp $0301

sw reset
r pc = 0300
;z 10
g

; this code should trigger a watchpoint every 7 cycles:

; #2 (Stop on store 0600)
; .8:0301  8D 00 06    STA $0600      - A:FF X:06 Y:FF SP:45 ..-..I.C    2629402

; However, the watchpoint is triggered at intervals of many thousands of cycles
; and sometimes even garbage instructions (EOR $06) are displayed.

break
dev c:
;z 10
g

break
dev c:
;z 10
g

break
dev c:
;z 10
g

dev c:
;z 10
g

dev c:
z 10

dev c:
z 10

dev c:
z 10

dev c:
z 10

dev c:
z 10

dev c:
z 10

chis 10

q
