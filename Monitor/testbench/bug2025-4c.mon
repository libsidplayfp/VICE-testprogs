
; related to https://sourceforge.net/p/vice-emu/bugs/2025/

; The assign registers command (r) somehow repeats the current
; instruction when the command is used

logname "bug2025-4c.log"
log on

break 1000
break e147

a 1000
inc $1004
rts
brk

keybuf sys4096\n
x

; here, INC $1004 is executed twice when using the assign registers command:

r pc = 1003
x

m 1004 1004
chis 5
q
